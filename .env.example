# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Signs crew/guest magic links. Generate with: openssl rand -base64 48
CAPABILITY_SECRET=
# Optional. Public origin used in crew/guest links. If unset it is taken from the request,
# which is right for localhost; set it in production (e.g. https://app.example.com).
# APP_ORIGIN=

# Photo storage (S3-compatible). Leave unset in development: photos are then fingerprinted but not kept.
# Cloudflare R2: endpoint is https://<account id>.r2.cloudflarestorage.com, region "auto".
# Create a private bucket and an API token limited to Object Read & Write on that bucket.
# See docs/decisions/0001-photo-storage.md.
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=auto
